# Only needed for the optional CLI route, scripts/deploy.sh. The Studio
# walkthrough in DEPLOY.md needs none of this, and the test suite runs offline.
GENLAYER_NETWORK=studionet

# Names of two accounts made with `genlayer account create`, one per party.
# The CLI keeps their keys in encrypted keystores; nothing secret goes here.
SELLER_ACCOUNT=seller
BUYER_ACCOUNT=buyer
